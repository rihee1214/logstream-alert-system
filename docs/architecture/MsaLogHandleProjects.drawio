        <mxCell id="tmtFoyBRQ7CB1CaWHIDz-3" value="&lt;font style=&quot;&quot;&gt;시스템 로그 전송&lt;br&gt;Kafka &lt;br&gt;(sys-log-topic)&lt;/font&gt;" style="edgeLabel;resizable=0;html=1;;align=center;verticalAlign=middle;labelBackgroundColor=light-dark(#FFFFFF,#FFFFFF);fontColor=light-dark(#000000,#000000);" connectable="0" vertex="1" parent="1">
