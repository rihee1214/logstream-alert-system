        <mxCell id="l7Rk71itEcOo-yo85EwS-14" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&lt;b&gt;Query Frontend&lt;/b&gt;&lt;br&gt;(쿼리 최적화 용&lt;br&gt;Thanos Component)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=light-dark(#000000,#333333);strokeWidth=2;fillColor=light-dark(#FFFFFF,#E8F0FE);opacity=50;dashed=1;" vertex="1" parent="1">
