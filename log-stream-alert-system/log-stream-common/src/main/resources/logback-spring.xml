<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="10 seconds">

    <!-- 분기 로직 -->
    <logger name="BIZ_LOGGER" level="INFO" additivity="false">
        <appender-ref ref="BIZ">
            <filter class="ch.qos.logback.classic.filter.MDCFilter">
                <MDCKey>logtype</MDCKey>
                <MDCValue>biz</MDCValue>
                <OnMatch>ACCEPT</OnMatch>
                <OnMismatch>DENY</OnMismatch>
            </filter>
        </appender-ref>
    </logger>

    <logger name="SYS_LOGGER" level="INFO" additivity="false">
        <appender-ref ref="SYS">
            <filter class="ch.qos.logback.classic.filter.MDCFilter">
                <MDCKey>logtype</MDCKey>
                <MDCValue>sys</MDCValue>
                <OnMatch>ACCEPT</OnMatch>
                <OnMismatch>DENY</OnMismatch>
            </filter>
        </appender-ref>
    </logger>

    <!-- BIZ 로그 전용 Appender -->
    <appender name="BIZ" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>timestamp</fieldName>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSZ</pattern>
                </timestamp>
                <pattern>
                    <pattern>
                        {
                        "logtype": "%X{logtype:biz}",
                        "level": "%level",
                        "service": "%X{service:-}",
                        "traceId": "%X{traceId:-}",
                        "spanId": "%X{spanId:-}",
                        "class": "%class",
                        "host": "%X{host:-}",
                        "container": "%X{container:-}",
                        "message": "%message",
                        "meta":%X{meta:-{}}
                        }
                    </pattern>
                </pattern>
            </providers>
        </encoder>
    </appender>

    <!-- SYS 로그 전용 Appender -->
    <appender name="SYS" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>timestamp</fieldName>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSZ</pattern>
                </timestamp>
                <pattern>
                    <pattern>
                        {
                        "logtype": "%X{logtype:sys}",
                        "level": "%level",
                        "service": "%X{service:-}",
                        "class": "%class",
                        "host": "%X{host:-}",
                        "container": "%X{container:-}",
                        "message": "%message",
                        "meta":%X{meta:-{}}
                        }
                    </pattern>
                </pattern>
                <stackTrace />
            </providers>
        </encoder>
    </appender>

    <!-- 디폴트 로그 전용 Appender -->
    <appender name="DEFAULT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>timestamp</fieldName>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSZ</pattern>
                </timestamp>
                <pattern>
                    <pattern>
                        {
                        "logtype": "%X{logtype:default}",
                        "level": "%level",
                        "service": "%X{service:-}",
                        "class": "%class",
                        "host": "%X{host:-}",
                        "container": "%X{container:-}",
                        "message": "%message",
                        "meta":%X{meta:-{}}
                        }
                    </pattern>
                </pattern>
            </providers>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="DEFAULT" />
    </root>

</configuration>
